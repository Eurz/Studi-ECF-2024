{% extends 'base.html.twig' %}

{% block title %}
	{{ page_title}}
{% endblock %}

{% block body %}
	<div><img src="{{ asset('./images/hero-banner.jpg')}}" class="img-fluid" alt="..."></div>
	<h1>{{page_title}}</h1>

	<div class="d-flex justify-content-between">
		<div class="">
			<h2>Nos véhicules d'occasions</h2>
		</div>
		{% if vehicles %}
			<div>
				<a href="{{ path('vehicles_index') }}" class="btn btn-primary">Découvrir nos véhicules</a>
			</div>
		{% endif %}
	</div>
	{% if vehicles %}
		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
			{% for vehicle in vehicles %}

				<div class=" col">
					{% include "./vehicles/_card.html.twig" %}
				</div>
			{% endfor %}
		</div>
	{% else %}
		<p>Aucun véhicule disponible actuellement.</p>
	{% endif %}

	<div class="d-flex justify-content-between">
		<div class="">
			<h2>Nos services</h2>
		</div>
		<div>
			<a href="{{ path('services_index') }}" class="btn btn-primary">Découvrir nos services</a>
		</div>
	</div>
	<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
		{% for service in services %}

			<div class="col">
				{% include "./services/_serviceCard.html.twig" %}
			</div>
		{% endfor %}
	</div>
{% endblock %}
